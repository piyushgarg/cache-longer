{
  "manifest_version": 3,
  "name": "Cache for Speed",
  "version": "1.3",
  "permissions": ["declarativeNetRequest", "declarativeNetRequestFeedback"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "cache_rules",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}